# Copy to .env and adjust. All values are optional.

# Password for the web app, and for the encrypted data file.
APP_PASSWORD=9987

# Keeps you signed in across restarts. Any long random string.
SESSION_SECRET=

# Where the server listens.
HOST=127.0.0.1
PORT=3000

# Set to true only when serving over HTTPS.
SECURE_COOKIE=false

# Only used by `npm run import`.
SOURCE_XLSX=D:/Google Drive/Ahmed/Finance/Financial Statements.xlsx
